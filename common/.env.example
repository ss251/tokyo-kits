# Common fork RPC configuration only. Copy to common/.env; keep credentials out
# of git. The launcher reads known RPC variables without shell evaluation and
# does not overwrite environment variables already exported by the caller.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ENS_RPC_URL is accepted as a Sepolia compatibility fallback only when
# SEPOLIA_RPC_URL is unset. Do not set both unless that precedence is intended.
# ENS_RPC_URL=https://ethereum-sepolia.publicnode.com

# No private signing key is needed. These launchers use local Anvil development
# accounts and never submit transactions to the upstream chain.
# Select an exact historical block through fork.py --block NUMBER.
# Sponsor API keys belong in each sponsor kit's own ignored .env file;
# see common/CREDENTIALS.md. They are not parsed from this file.
