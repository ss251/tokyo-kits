# Public defaults need no keys. Use an archive RPC if public endpoints limit reads.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
FORK_CHAIN=polygon
# Optional deterministic replay block; otherwise latest block is captured in receipt.
# FORK_BLOCK_NUMBER=
# A local fork only: the demo creates disposable, ephemeral accounts.
# Never use a mainnet private key here.
