# Official MultiBaas deployment URL for Ethereum Sepolia.
# Create it through https://console.curvegrid.com and follow README.md.
# Keep API keys private. A Curvegrid Testnet public Web3 key is not this API key.
MULTIBAAS_URL=

# Setup credential: upload/deploy/link contracts and configure the webhook.
MULTIBAAS_ADMIN_API_KEY=
# Runtime credential: Blockchain API access for calls, submission, and events.
MULTIBAAS_API_KEY=

# Independent RPC used to verify the chain and transaction receipts.
CURVEGRID_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional chain pin; any value other than 11155111 is rejected.
CHAIN_ID=11155111

# Optional Sepolia-only signer. When absent, the runner generates an ignored
# .run signer. Never add a production key or commit .env/private .run files.
# CURVEGRID_PRIVATE_KEY=0x...

# Required for the events path: public HTTPS URL ending in /webhook, forwarded
# to the standalone consumer (default 127.0.0.1:8787). Preserve raw request bytes.
MULTIBAAS_WEBHOOK_URL=

# The events/all demo manages this listener automatically; do not start another
# server on the same port. Optional ongoing standalone consumer:
# bun events-webhooks/server.ts
# The demo writes a private config file containing its API-generated secret.
# Default file: .run/webhook-config.json. Override only with a private path.
# MULTIBAAS_WEBHOOK_CONFIG=.run/webhook-config.json
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8787

# Alternative to the private config file: supply ALL of these consumer fields.
# CHAIN_ID above must still be 11155111. Event signature is fixed by the kit.
# CONTRACT_ADDRESS=0x...
# MULTIBAAS_WEBHOOK_SECRET=
# MULTIBAAS_DEPLOYMENT_ID=
# MULTIBAAS_WEBHOOK_ID=
