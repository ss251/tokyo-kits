# Copy to .env; never commit .env, private proofs, wallet keys, or SQLite state.
# Next.js runs on Node 24+. The CLI uses Bun. Exact package pins are in package.json.

# Exact browser origin, including your HTTPS development tunnel when using World App.
WORLD_APP_ORIGIN=http://localhost:3000

# Mini App and World ID may be separate applications in https://developer.world.org.
# Public app IDs are exposed to the browser; RP signing keys stay on the server.
WORLD_MINIKIT_APP_ID=
WORLD_ID_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ID_ACTION=tokyo-kits-verify
WORLD_ID_ENVIRONMENT=staging
WORLD_ID_TTL_SECONDS=300
WORLD_ID_DATABASE=.run/world-id.sqlite
WORLD_WALLET_DATABASE=.run/wallet-auth.sqlite

# Both official World ID v4 production/staging on-chain verifiers use World Chain 480.
# The legacy World Chain Sepolia verifier is not compatible with the v4 proof ABI.
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
FORK_BLOCK_NUMBER=

# Public World Chain deployment of src/WorldPing.sol, not an ephemeral fork address.
# Set true only after adding this contract to the Mini App Portal allowlist.
WORLD_PING_ADDRESS=
WORLD_PING_ALLOWLIST_CONFIRMED=false

# Optional CLI input: a fresh authentic proof exported by the UI. Keep it in .run/.
# No synthetic proof is accepted as end-to-end evidence.
WORLD_PROOF_FILE=.run/world-id-private-proof.json

# Optional AgentKit CLI input: a human-registered agent EOA, never exposed to Next UI.
# This is a private signing key. Leave empty until a developer supplies one privately.
WORLD_AGENT_PRIVATE_KEY=
